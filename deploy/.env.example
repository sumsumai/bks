# Your domain, already pointing (A/AAAA record) at this server.
DOMAIN=bks.example.com

# Generate each secret with:  openssl rand -base64 32
POSTGRES_PASSWORD=
APP_ENCRYPTION_KEY=
WA_GATEWAY_SECRET=
CRON_SECRET=

# Optional at first boot; can also be set later in Admin → Settings.
ANTHROPIC_API_KEY=
