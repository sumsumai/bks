# Local development. Production: see DEPLOY.md (deploy/.env).

# Postgres 15+ (`docker compose up -d` at the repo root starts one on 5436).
DATABASE_URL=postgres://bks:bks@127.0.0.1:5436/bks
# 32+ random bytes. Encrypts secrets at rest (platform keys, WhatsApp sessions). Same value on the gateway.
# Leave empty in development only. `openssl rand -base64 32`
APP_ENCRYPTION_KEY=
# Protects /api/cron/reminders (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
# WhatsApp gateway (apps/wa-gateway). Same secret on both sides.
WA_GATEWAY_URL=http://127.0.0.1:3300
WA_GATEWAY_SECRET=dev-gateway-secret

# Optional bootstrap values. Everything below is managed in Admin → Settings / Telegram bot once the
# app runs; a value saved there takes precedence over these.
APP_URL=http://localhost:3200
ANTHROPIC_API_KEY=
AGENT_MODEL=
AGENT_EFFORT=
AGENT_TAKEOVER_TIMEOUT_HOURS=
WA_STALE_MINUTES=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
